{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",

        "friendRequestsIncoming": {
          "$fromUid": {
            ".write": "auth != null && auth.uid === $fromUid"
          }
        },

        "friendRequestsOutgoing": {
          "$toUid": {
            ".write": "auth != null && auth.uid === $toUid"
          }
        },

        "friends": {
          "$friendUid": {
            ".write": "auth != null && (auth.uid === $uid || auth.uid === $friendUid)"
          }
        }
      }
    },

    "nicknames": {
      "$nick": {
        ".read": true,
        ".write": "auth != null && (!data.exists() || data.val() === auth.uid)"
      }
    },

    "dmThreads": {
      "$threadId": {
        ".read": "auth != null && $threadId.contains(auth.uid)",

        "messages": {
          "$msgId": {
            ".write": "auth != null && $threadId.contains(auth.uid) && !data.exists() && newData.child('from').val() === auth.uid",
            ".validate": "newData.hasChildren(['text', 'from', 'at']) && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 1000"
          }
        }
      }
    },

    "rooms": {
      "$roomCode": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('ownerId').val() === auth.uid)",

        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },

        "chat": {
          "$msgId": {
            ".write": "auth != null && !data.exists() && newData.child('byId').val() === auth.uid",
            ".validate": "newData.hasChildren(['text', 'by', 'byId', 'at']) && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 1000"
          }
        },

        "rolls": {
          "$rollId": {
            ".write": "auth != null && !data.exists()"
          }
        },

        "scene": {
          "mapPins": {
            "$pinId": {
              ".write": "auth != null && ((!data.exists() && newData.child('byId').val() === auth.uid) || (!newData.exists() && data.child('byId').val() === auth.uid))"
            }
          }
        }
      }
    }
  }
}
